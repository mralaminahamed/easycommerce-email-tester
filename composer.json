{
	"name": "mralaminahamed/easycommerce-email-tester",
	"description": "A developer tool to test, preview, and debug all EasyCommerce email notifications.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Al Amin Ahamed",
			"email": "me@alaminahamed.com",
			"homepage": "https://github.com/mralaminahamed/"
		}
	],
	"homepage": "https://github.com/mralaminahamed/easycommerce-email-tester",
	"support": {
		"issues": "https://github.com/mralaminahamed/easycommerce-email-tester/issues",
		"source": "https://github.com/mralaminahamed/easycommerce-email-tester"
	},
	"require": {
		"php": ">=8.0",
		"ext-json": "*"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.4",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.7",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"classmap": [
			"includes/"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.0"
		}
	},
	"scripts": {
		"makepot": "wp i18n make-pot . languages/easycommerce-email-tester.pot --exclude=node_modules,vendor,docs,build,release,tests",
		"phpcbf": "phpcbf --standard=phpcs.xml",
		"phpcbf:plugin-review": "phpcbf --standard=phpcs.plugin-review.xml",
		"phpcs": "phpcs --standard=phpcs.xml",
		"phpcs:plugin-review": "phpcs --standard=phpcs.plugin-review.xml",
		"phpstan": "phpstan analyse --memory-limit 2G",
		"release": [
			"rm -rf release vendor",
			"@makepot",
			"mkdir -p release",
			"composer install --no-dev --optimize-autoloader",
			"rsync -av --exclude-from=.distignore . release/easycommerce-email-tester/",
			"cd release && zip -r easycommerce-email-tester.zip easycommerce-email-tester/",
			"rm -rf release/easycommerce-email-tester/",
			"composer install"
		],
		"test": "phpunit"
	}
}
